/* pages/handle/handle.wxss */
page {
  background-color: #f5f5f5;
  min-height: 100vh;
}

.container {
  padding: 20rpx;
}

.header {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 30rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.handle-container {
  background-color: white;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  width: 90%;
  margin: 0 auto;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 15rpx;
  font-weight: 500;
}

.picker {
  display: flex;
  align-items: center;
  height: 80rpx;
  padding: 0 20rpx;
  background-color: #f9f9f9;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #666;
}

.location-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 80rpx;
  padding: 0 20rpx;
  background-color: #f9f9f9;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #666;
}

.upload-container {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.upload-item {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  border-radius: 10rpx;
  overflow: hidden;
}

.upload-item image {
  width: 100%;
  height: 100%;
}

.upload-item icon {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  background-color: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  padding: 4rpx;
}

.upload-btn {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 140rpx;
  height: 140rpx;
  border: 2rpx dashed #ccc;
  border-radius: 10rpx;
  background-color: #f9f9f9;
}

.upload-btn text {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 20rpx;
  background-color: #f9f9f9;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  box-sizing: border-box;
}

.word-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.submit-btn {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 80rpx;
  background-color: #1E88E5;
  border-radius: 40rpx;
  margin-top: 40rpx;
}

.submit-btn text {
  font-size: 32rpx;
  color: white;
  font-weight: bold;
}

.submit-btn:active {
  background-color: #1976D2;
}
