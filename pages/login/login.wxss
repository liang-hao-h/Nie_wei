/* pages/login/login.wxss */
.login-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background: linear-gradient(135deg, #1296db 0%, #1677FF 100%);
  padding: 40rpx;
  box-sizing: border-box;
}

.login-header {
  text-align: center;
  margin-bottom: 80rpx;
}

.login-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 20rpx;
  display: block;
}

.login-subtitle {
  font-size: 32rpx;
  color: #ffffff;
  opacity: 0.8;
}

.login-form {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  width: 600rpx;
  max-width: 90vw;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.1);
  box-sizing: border-box;
}

.input-group {
  margin-bottom: 40rpx;
  width: 100%;
}

.input-label {
  display: block;
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 15rpx;
  font-weight: 500;
}

.input-field {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 10rpx;
  padding: 0 25rpx;
  font-size: 28rpx;
  background: #f8f9fa;
  transition: border-color 0.3s;
  box-sizing: border-box;
}

.input-field:focus {
  border-color: #1296db;
  background: #ffffff;
}

/* 记住我样式 */
.remember-me {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
  padding: 0 5rpx;
}

.remember-checkbox {
  transform: scale(0.8);
  margin-right: 10rpx;
}

.remember-text {
  font-size: 26rpx;
  color: #666666;
}

.login-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #1296db 0%, #1677FF 100%);
  border: none;
  border-radius: 10rpx;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 30rpx;
}

.login-btn:active {
  opacity: 0.8;
}

.fingerprint-btn {
  width: 100%;
  height: 88rpx;
  background: #f8f9fa;
  border: 2rpx solid #e0e0e0;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15rpx;
}

.fingerprint-icon {
  width: 36rpx;
  height: 36rpx;
  display: block;
}

.fingerprint-text {
  font-size: 28rpx;
  color: #666666;
}

/* 适配小屏幕 */
@media (max-width: 375px) {
  .login-form {
    padding: 50rpx 30rpx;
  }
  
  .login-title {
    font-size: 42rpx;
  }
  
  .login-subtitle {
    font-size: 28rpx;
  }
  
  .input-field {
    height: 75rpx;
    font-size: 26rpx;
  }
  
  .login-btn, .fingerprint-btn {
    height: 80rpx;
    font-size: 30rpx;
  }
  
  .fingerprint-icon {
    width: 32rpx;
    height: 32rpx;
  }
}
