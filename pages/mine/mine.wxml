<!-- 个人中心页面 -->
<view class="page-container">
  <!-- 个人信息容器 -->
  <view class="profile-container">
    <!-- 左侧头像区域 -->
    <view class="avatar-section">
      <view class="avatar-wrapper">
        <image class="avatar" src="{{avatarUrl}}" mode="aspectFill"></image>
        <view class="avatar-edit" bindtap="onAvatarEdit">更改</view>
      </view>
    </view>
    
    <!-- 中间用户信息区域 -->
    <view class="info-section">
      <text class="username">{{username}}</text>
    </view>
    
    <!-- 右侧状态区域 -->
    <view class="status-section" bindtap="onStatusChange">
      <view class="status-indicator {{statusClass}}">
        <view class="status-dot"></view>
        <text class="status-label">{{statusText}}</text>
      </view>
    </view>
  </view>

  <!-- 事件分类容器 -->
  <view class="events-container">
    <!-- 分类标签 -->
    <view class="category-tabs">
      <view class="tab-item {{currentTab === 0 ? 'active' : ''}}" bindtap="switchTab" data-tab="0">
        全部
      </view>
      <view class="tab-item {{currentTab === 1 ? 'active' : ''}}" bindtap="switchTab" data-tab="1">
        待处理
      </view>
      <view class="tab-item {{currentTab === 2 ? 'active' : ''}}" bindtap="switchTab" data-tab="2">
        已处理
      </view>
    </view>

    <!-- 事件列表 -->
          <scroll-view class="events-list" scroll-y>
            <block wx:if="{{filteredEvents.length > 0}}" wx:for="{{filteredEvents}}" wx:key="id">
              <view class="event-item {{item.status}}-status">
                <!-- 事件头部信息 -->
                <view class="event-header">
                  <text class="event-title">{{item.title}}</text>
                  <text class="event-time">{{item.time}}</text>
                </view>
                
                <!-- 事件内容信息 -->
                <view class="event-content">
                  <text class="event-location">{{item.location}}</text>
                  <text class="event-status {{item.status}}-status">{{item.status === 'pending' ? '待处理' : '已完成'}}</text>
                </view>
              </view>
            </block>
            
            <!-- 空状态提示 -->
            <view wx:if="{{filteredEvents.length === 0}}" class="empty-state">
              <text class="empty-text">暂无相关事件</text>
            </view>
          </scroll-view>
  </view>

  <!-- 退出登录按钮 -->
  <view class="logout-container">
    <button class="logout-btn" bindtap="onLogout">退出登录</button>
  </view>

</view>