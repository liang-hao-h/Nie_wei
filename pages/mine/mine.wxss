/* 个人中心页面样式 */
.page-container {
  min-height: 100vh;
  background-color: #f5f5f5; /* 灰白色背景 */
  padding: 20rpx;
  box-sizing: border-box;
}

/* 确保页面整体背景为灰白色 */
page {
  background-color: #f5f5f5;
  height: 100%;
}

/* 个人信息容器 */
.profile-container {
  width: 90%;
  height: 160rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  margin: 0 auto;
  position: relative;
}

/* 头像区域 */
.avatar-section {
  flex: 0 0 auto;
}

.avatar-wrapper {
  position: relative;
  width: 100rpx;
  height: 100rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 20rpx;
  background-color: #f0f0f0;
}

.avatar-edit {
  position: absolute;
  bottom: -10rpx;
  right: -10rpx;
  background-color: #007AFF;
  color: white;
  font-size: 20rpx;
  padding: 4rpx 8rpx;
  border-radius: 12rpx;
  transform: scale(0.8);
}

/* 用户信息区域 */
.info-section {
  flex: 1;
  margin-left: 30rpx;
}

.username {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

/* 状态区域 */
.status-section {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.status-indicator {
  width: 100rpx;
  height: 44rpx;
  border-radius: 22rpx;
  margin-bottom: 10rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 0 12rpx;
}

.status-indicator.online {
  background-color: rgba(82, 196, 26, 0.2); /* 浅绿色 - 在线 */
  border: 1rpx solid rgba(82, 196, 26, 0.3);
}

.status-indicator.offline {
  background-color: rgba(191, 191, 191, 0.2); /* 浅灰色 - 离线 */
  border: 1rpx solid rgba(191, 191, 191, 0.3);
}

.status-indicator.processing {
  background-color: rgba(250, 140, 22, 0.2); /* 浅橙色 - 处理中 */
  border: 1rpx solid rgba(250, 140, 22, 0.3);
}

.status-label {
  font-size: 24rpx;
  color: #333333;
  font-weight: 500;
  line-height: 44rpx; /* 与容器高度一致 */
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  text-align: center;
  padding: 0;
  margin: 0;
}

.status-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  align-self: center; /* 垂直居中 */
  margin-right: 12rpx; /* 小圆点和文字之间的间距 */
}

.status-indicator.online .status-dot {
  background-color: #52C41A; /* 绿色圆点 - 在线 */
}

.status-indicator.offline .status-dot {
  background-color: #BFBFBF; /* 灰色圆点 - 离线 */
}

.status-indicator.processing .status-dot {
  background-color: #FA8C16; /* 橙色圆点 - 处理中 */
}

.status-text {
  font-size: 24rpx;
  color: #666666;
}

/* 事件分类容器 */
.events-container {
  width: 98%;
  height: 500rpx; /* 固定高度 */
  background-color: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
  margin: 30rpx auto 0;
  padding: 30rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* 分类标签 */
.category-tabs {
  display: flex;
  border-bottom: 2rpx solid #f0f0f0;
  margin-bottom: 30rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666666;
  position: relative;
  transition: all 0.3s;
}

.tab-item.active {
  color: #007AFF;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: -2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background-color: #007AFF;
  border-radius: 2rpx;
}

/* 事件列表 */
.events-list {
  flex: 1;
  overflow-y: auto;
  max-height: 400rpx;
}

/* 事件项 */
.event-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.event-item:last-child {
  border-bottom: none;
}

/* 事件头部信息 */
.event-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.event-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  flex: 1;
}

.event-time {
  font-size: 24rpx;
  color: #999999;
}

/* 事件内容信息 */
.event-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.event-location {
  font-size: 26rpx;
  color: #666666;
  flex: 1;
}

/* 事件状态 */
.event-status {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
  min-width: 80rpx;
  text-align: center;
}

.event-status.pending-status {
  background-color: rgba(245, 34, 45, 0.1);
  color: #F5222D;
  border: 1rpx solid rgba(245, 34, 45, 0.3);
}

.event-status.completed-status {
  background-color: rgba(82, 196, 26, 0.1);
  color: #52C41A;
  border: 1rpx solid rgba(82, 196, 26, 0.3);
}

/* 空状态提示 */
.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 200rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

/* 退出登录按钮容器 */
.logout-container {
  width: 100%;
  padding: 40rpx 0;
  display: flex;
  justify-content: center;
}

/* 退出登录按钮 */
.logout-btn {
  width: 90%;
  height: 80rpx;
  background-color: #F5222D;
  color: #ffffff;
  border: none;
  border-radius: 40rpx;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(245, 34, 45, 0.3);
}

.logout-btn:active {
  background-color: #D81E06;
  transform: scale(0.98);
}

